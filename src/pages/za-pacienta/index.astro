---
import { readCollection, readSingleton } from '../../lib/content'
import LandingLayout from '../../layouts/LandingLayout.astro'
import Hero from '../../components/sections/Hero.astro'
import CTASection from '../../components/sections/CTASection.astro'

const [sectionsRaw, pageHeroes] = await Promise.all([
  readCollection('patient-info'),
  readSingleton('page-heroes'),
])
const sections = sectionsRaw.sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99))
---

<LandingLayout
  title="За пациента — БПЛР–БАНКЯ"
  description="Информация за пациенти: прием по клинични пътеки, НЗОК, НОИ, платен прием и военен контингент в БПЛР–Банкя."
>
  <Hero
    headline={pageHeroes?.zaPatsienta?.headline || 'Информация за пациенти'}
    subheadline={pageHeroes?.zaPatsienta?.subheadline || 'Всичко, което трябва да знаете преди постъпване.'}
    ctaLabel={pageHeroes?.zaPatsienta?.ctaLabel || undefined}
    ctaUrl={pageHeroes?.zaPatsienta?.ctaUrl || undefined}
  />

  <section class="bg-white py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-gray-900 mb-10 text-center">
        Начини на прием
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {sections.map((s) => (
          <a
            href={`/za-pacienta/${s.slug}`}
            class="group flex items-center gap-4 p-5 rounded-2xl border border-gray-200 bg-white hover:border-blue-300 hover:shadow-md transition-all"
          >
            <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center shrink-0 font-bold text-lg group-hover:bg-blue-100 transition-colors">
              {s.entry.order ?? '•'}
            </div>
            <span class="font-semibold text-gray-900 group-hover:text-blue-700 transition-colors">
              {s.entry.title}
            </span>
            <svg class="w-4 h-4 text-gray-400 ml-auto group-hover:text-blue-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Телефон</h3>
          <a href="tel:029977194" class="text-blue-700 font-semibold hover:text-blue-900 transition-colors">02 997 7194</a>
          <p class="text-xs text-gray-400 mt-1">Пон – Пет: 08:00 – 18:00</p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Имейл</h3>
          <a href="mailto:bbbankya@abv.bg" class="text-blue-700 font-semibold hover:text-blue-900 transition-colors">bbbankya@abv.bg</a>
          <p class="text-xs text-gray-400 mt-1">Отговаряме в рамките на деня</p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Адрес</h3>
          <p class="text-gray-700 font-medium text-sm">гр. Банкя</p>
          <p class="text-gray-500 text-xs mt-0.5">ул. „Цар Симеон" № 2</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    heading="Не намерихте отговора?"
    body="Свържете се с нас директно — ще се радваме да ви помогнем с избора на правилния начин на прием."
    ctaLabel="Изпратете запитване"
    ctaUrl="/kontakti"
    variant="light"
  />
</LandingLayout>
