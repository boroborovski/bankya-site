---
import { readCollectionEntry, readCollection } from '../../lib/content'
import LandingLayout from '../../layouts/LandingLayout.astro'
import CTASection from '../../components/sections/CTASection.astro'
import Markdoc from '@markdoc/markdoc'
import { markdocConfig } from '../../lib/markdoc-config'
import fs from 'node:fs/promises'
import path from 'node:path'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/za-pacienta')

const [entryData, allEntries] = await Promise.all([
  readCollectionEntry('patient-info', slug),
  readCollection('patient-info'),
])

if (!entryData) return Astro.redirect('/za-pacienta')
const entry = entryData.entry

const filePath = path.join(process.cwd(), 'content/patient-info', `${slug}.md`)
const raw = await fs.readFile(filePath, 'utf8')
// Strip YAML frontmatter (everything between the first two --- markers)
const withoutFrontmatter = raw.replace(/^---[\s\S]*?---\s*/, '')
const ast = Markdoc.parse(withoutFrontmatter)
const transformed = Markdoc.transform(ast, markdocConfig)
const html = Markdoc.renderers.html(transformed)

const siblings = allEntries.sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99))
const currentIndex = siblings.findIndex((s) => s.slug === slug)
const prev = siblings[currentIndex - 1] ?? null
const next = siblings[currentIndex + 1] ?? null
---

<LandingLayout
  title={`${entry.title} — За пациента — БПЛР–БАНКЯ`}
  description={`Информация за пациенти: ${entry.title}. БПЛР–Банкя.`}
>
  <div class="bg-white py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
        <a href="/" class="hover:text-blue-700 transition-colors">Начало</a>
        <span>/</span>
        <a href="/za-pacienta" class="hover:text-blue-700 transition-colors">За пациента</a>
        <span>/</span>
        <span class="text-gray-900 font-medium">{entry.title}</span>
      </nav>

      <div class="lg:grid lg:grid-cols-[220px_1fr] lg:gap-12">

        <!-- Sidebar nav -->
        <aside class="hidden lg:block">
          <nav class="sticky top-24">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">За пациента</p>
            <ul class="space-y-1">
              {siblings.map((s) => (
                <li>
                  <a
                    href={`/za-pacienta/${s.slug}`}
                    class={`block px-3 py-2 rounded-lg text-sm transition-colors ${
                      s.slug === slug
                        ? 'bg-blue-50 text-blue-700 font-semibold'
                        : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
                    }`}
                  >
                    {s.entry.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Main content -->
        <article>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 mb-8">
            {entry.title}
          </h1>

          <div class="prose prose-blue prose-lg max-w-none
            prose-headings:font-bold prose-headings:tracking-tight
            prose-a:text-blue-700 prose-a:no-underline hover:prose-a:underline
            prose-table:w-full prose-table:text-sm prose-table:border-collapse
            prose-th:bg-blue-50 prose-th:text-blue-900 prose-th:font-semibold prose-th:px-4 prose-th:py-2 prose-th:text-left prose-th:border prose-th:border-blue-200
            prose-td:px-4 prose-td:py-2 prose-td:border prose-td:border-gray-200
            prose-img:rounded-xl prose-img:shadow-md">
            <Fragment set:html={html} />
          </div>

          <!-- Prev / Next -->
          <div class="mt-12 pt-8 border-t border-gray-100 flex justify-between gap-4">
            {prev ? (
              <a href={`/za-pacienta/${prev.slug}`} class="flex items-center gap-2 text-sm text-gray-500 hover:text-blue-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                {prev.entry.title}
              </a>
            ) : <span />}
            {next ? (
              <a href={`/za-pacienta/${next.slug}`} class="flex items-center gap-2 text-sm text-gray-500 hover:text-blue-700 transition-colors">
                {next.entry.title}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : <span />}
          </div>
        </article>
      </div>
    </div>
  </div>

  <CTASection
    heading="Имате въпроси?"
    body="Свържете се с нас за информация за прием, клинични пътеки и свободни места."
    ctaLabel="Свържете се с нас"
    ctaUrl="/kontakti"
    variant="light"
  />
</LandingLayout>
