---
import LandingLayout from '../layouts/LandingLayout.astro'
import Hero from '../components/sections/Hero.astro'
import PatientAccordion from '../components/islands/PatientAccordion.svelte'
import CTASection from '../components/sections/CTASection.astro'

const sections = [
  {
    id: 'obshta',
    title: 'Обща информация',
    content: `
      <p class="mb-3">БПЛР–Банкя е болница за продължително лечение и рехабилитация, приемаща пациенти с разнообразни диагнози. Болницата разполага с над 200 легла в комфортни болнични стаи.</p>
      <p class="mb-3">Приемът на пациентите се извършва всеки работен ден от 08:00 до 16:00 часа. При постъпване пациентите трябва да представят:</p>
      <ul class="list-disc pl-5 space-y-1.5 mb-3">
        <li>Лична карта</li>
        <li>Здравноосигурителна книжка или здравна карта (за прием по НЗОК)</li>
        <li>Направление от лекар специалист (Бл. 3 или Бл. 7)</li>
        <li>Медицинска документация — епикризи, изследвания, образна диагностика</li>
        <li>Лекарства, ако пациентът приема такива</li>
      </ul>
      <p>Престоят е съобразен с клиничната пътека или с договора за платен прием. Медицинският екип провежда ежедневен обход и осъществява постоянен мониторинг на пациентите.</p>
    `,
  },
  {
    id: 'klinichni',
    title: 'Клинични пътеки',
    content: `
      <p class="mb-3">Болницата работи по следните клинични пътеки, финансирани от Националната здравноосигурителна каса (НЗОК):</p>
      <ul class="list-disc pl-5 space-y-1.5 mb-3">
        <li><strong>КП 235:</strong> Физикална терапия и рехабилитация при заболявания на периферна нервна система</li>
        <li><strong>КП 236:</strong> Физикална терапия и рехабилитация при заболявания на централна нервна система</li>
        <li><strong>КП 237:</strong> Физикална терапия и рехабилитация при заболявания на опорно-двигателен апарат</li>
        <li><strong>КП 263:</strong> Продължително лечение при болести на дихателната система</li>
        <li><strong>КП 264:</strong> Продължително лечение при болести на опорно-двигателния апарат</li>
      </ul>
      <p class="mb-3">За прием по клинична пътека са необходими:</p>
      <ul class="list-disc pl-5 space-y-1.5">
        <li>Направление Бл. 7 (за хоспитализация) от личния лекар или специалист</li>
        <li>Здравноосигурителна книжка с платени осигуровки</li>
        <li>Актуална медицинска документация (не по-стара от 6 месеца)</li>
      </ul>
    `,
  },
  {
    id: 'noi',
    title: 'НОИ — Национален осигурителен институт',
    content: `
      <p class="mb-3">БПЛР–Банкя приема осигурени лица, насочени от Националния осигурителен институт (НОИ) за профилактика и рехабилитация.</p>
      <p class="mb-3">Имате право на санаторно-курортно лечение, ако:</p>
      <ul class="list-disc pl-5 space-y-1.5 mb-3">
        <li>Сте осигурен по КСО (Кодекс за социално осигуряване)</li>
        <li>Имате направление от личния лекар или специалист</li>
        <li>Страдате от хронично заболяване, включено в наредбата</li>
      </ul>
      <p class="mb-3">Процедура за насочване:</p>
      <ol class="list-decimal pl-5 space-y-1.5">
        <li>Получете направление (Бл. МЗ–НЗОК №3) от лекуващия лекар</li>
        <li>Подайте заявление в местното поделение на НОИ</li>
        <li>НОИ издава удостоверение за санаторно-курортно лечение</li>
        <li>Свържете се с нас за уточняване на датите и свободни места</li>
      </ol>
    `,
  },
  {
    id: 'platen',
    title: 'Платен прием',
    content: `
      <p class="mb-3">Болницата приема пациенти при платен режим — без задължителни направления и без ограничения по здравно осигуряване. Платеният прием е подходящ за:</p>
      <ul class="list-disc pl-5 space-y-1.5 mb-3">
        <li>Лица без здравно осигуряване</li>
        <li>Пациенти, желаещи допълнителна рехабилитация извън НЗОК</li>
        <li>Профилактично лечение и балнеолечение</li>
        <li>Лица, насочени от корпоративни застрахователни полици</li>
      </ul>
      <p class="mb-3">При платен прием получавате:</p>
      <ul class="list-disc pl-5 space-y-1.5 mb-3">
        <li>Настаняване в болнична стая</li>
        <li>Три хранения на ден</li>
        <li>Преглед от специалист и изготвяне на рехабилитационен план</li>
        <li>Процедури съгласно предписанието</li>
      </ul>
      <p>За ценова информация и свободни места се свържете с нас на <a href="tel:029977194" class="text-blue-700 font-semibold hover:underline">02 997 7194</a> или изпратете запитване чрез контактната форма.</p>
    `,
  },
  {
    id: 'voenen',
    title: 'Военен контингент',
    content: `
      <p class="mb-3">БПЛР–Банкя е болница към Военномедицинска академия (ВМА) и приема военнослужещи, резервисти и цивилни служители на Министерство на отбраната за рехабилитационно лечение.</p>
      <p class="mb-3">Военнослужещите се насочват към болницата чрез:</p>
      <ul class="list-disc pl-5 space-y-1.5 mb-3">
        <li>Направление от военния лекар на поделението</li>
        <li>Заповед от командир на поделение (при профилактичен отдих)</li>
        <li>Направление от лекар в структура на ВМА</li>
      </ul>
      <p class="mb-3">Правото на безплатна или преференциална рехабилитация се определя от Правилника за военномедицинско осигуряване и вътрешните наредби на МО.</p>
      <p>За допълнителна информация и записване се обадете на <a href="tel:029977194" class="text-blue-700 font-semibold hover:underline">02 997 7194</a>.</p>
    `,
  },
]
---

<LandingLayout
  title="За пациента — БПЛР–БАНКЯ"
  description="Информация за пациенти: прием по клинични пътеки, НЗОК, НОИ, платен прием и военен контингент в БПЛР–Банкя."
>
  <Hero
    headline="Информация за пациенти"
    subheadline="Всичко, което трябва да знаете преди постъпване — начини на прием, необходими документи и условия на лечение."
    ctaLabel="Запишете час"
    ctaUrl="/kontakti"
  />

  <section class="bg-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900">
          Начини на прием
        </h2>
        <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">
          Изберете секцията, която се отнася за вас, за да научите повече за необходимите документи и условия.
        </p>
      </div>

      <PatientAccordion items={sections} client:load />
    </div>
  </section>

  <!-- Quick info cards -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Телефон</h3>
          <a href="tel:029977194" class="text-blue-700 font-semibold hover:text-blue-900 transition-colors">
            02 997 7194
          </a>
          <p class="text-xs text-gray-400 mt-1">Пон – Пет: 08:00 – 18:00</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Имейл</h3>
          <a href="mailto:bbbankya@abv.bg" class="text-blue-700 font-semibold hover:text-blue-900 transition-colors">
            bbbankya@abv.bg
          </a>
          <p class="text-xs text-gray-400 mt-1">Отговаряме в рамките на деня</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-1">Адрес</h3>
          <p class="text-gray-700 font-medium text-sm">гр. Банкя</p>
          <p class="text-gray-500 text-xs mt-0.5">ул. „Цар Симеон" № 2</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    heading="Не намерихте отговора?"
    body="Свържете се с нас директно — ще се радваме да ви помогнем с избора на правилния начин на прием."
    ctaLabel="Изпратете запитване"
    ctaUrl="/kontakti"
    variant="light"
  />
</LandingLayout>
