---
import { readSingleton } from '../lib/content'
import LandingLayout from '../layouts/LandingLayout.astro'
import Hero from '../components/sections/Hero.astro'
import Gallery from '../components/islands/Gallery.svelte'

const [galleryData, pageHeroes] = await Promise.all([
  readSingleton('gallery'),
  readSingleton('page-heroes'),
])

const images = (galleryData?.images ?? [])
  .map((g) => ({
    src: g.image ?? '',
    alt: g.alt || '',
    caption: g.caption || undefined,
    category: g.category || undefined,
    youtubeUrl: g.youtubeUrl || undefined,
  }))
  .filter((g) => g.src || g.youtubeUrl)
---

<LandingLayout
  title="Галерия — БПЛР–БАНКЯ"
  description="Снимки на болничната база, отделенията и прилежащата среда на БПЛР–Банкя."
>
  <Hero
    headline={pageHeroes?.galeriya?.headline || 'Галерия'}
    subheadline={pageHeroes?.galeriya?.subheadline || 'Снимки на болничната база и природната среда на Банкя.'}
  />

  <section class="bg-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Gallery images={images} client:load />
    </div>
  </section>
</LandingLayout>
