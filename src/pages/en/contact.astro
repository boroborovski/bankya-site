---
import { readSingleton } from '../../lib/content'
import LandingLayout from '../../layouts/LandingLayout.astro'
import Hero from '../../components/sections/Hero.astro'
import ContactForm from '../../components/islands/ContactForm.svelte'

const [pageHeroes, settings] = await Promise.all([
  readSingleton('page-heroes', 'en'),
  readSingleton('settings'),
])

const phone   = settings?.phone   || '02 997 7194'
const email   = settings?.email   || 'bbbankya@abv.bg'
const address = settings?.address || 'гр. Банкя, ул. „Цар Симеон" № 2, 1320'
const hours   = settings?.hours   || 'Понеделник – Петък: 08:00 – 18:00'
const mapsEmbedUrl = settings?.mapsEmbedUrl || 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2935.123!2d23.2695!3d42.7285!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40aa5c0b9e4c0001%3A0x0!2z0JHQsNC90LrRjywg0KHQvtGC0LjRjw!5e0!3m2!1sbg!2sbg!4v1'
const mapsLinkUrl  = settings?.mapsLinkUrl  || 'https://maps.google.com/?q=Bankya+Sofia'

const phoneHref = `tel:${phone.replace(/\s/g, '')}`
---

<LandingLayout
  title="Contact — BPLR–BANKYA"
  description="Contact BPLR–Bankya. Phone, email, address and enquiry form."
  lang="en"
>
  <Hero
    headline={pageHeroes?.kontakti?.headline || 'Contact Us'}
    subheadline={pageHeroes?.kontakti?.subheadline || 'Get in touch for information about admission.'}
  />

  <section class="bg-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

        <!-- Contact form -->
        <div>
          <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Send an Enquiry</h2>
          <p class="text-gray-500 mb-8">Fill in the form and we will get back to you within the working day.</p>
          <ContactForm client:load />
        </div>

        <!-- Info panel -->
        <div class="space-y-6">
          <h2 class="text-2xl font-extrabold text-gray-900">Information</h2>

          <div class="space-y-4">
            <!-- Address -->
            <div class="flex items-start gap-4 p-5 bg-gray-50 rounded-2xl">
              <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-0.5">Address</h3>
                <p class="text-gray-600 text-sm">{address}</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4 p-5 bg-gray-50 rounded-2xl">
              <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-0.5">Phone</h3>
                <a href={phoneHref} class="text-blue-700 font-medium hover:text-blue-900 transition-colors">
                  {phone}
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4 p-5 bg-gray-50 rounded-2xl">
              <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-0.5">Email</h3>
                <a href={`mailto:${email}`} class="text-blue-700 font-medium hover:text-blue-900 transition-colors">
                  {email}
                </a>
              </div>
            </div>

            <!-- Hours -->
            <div class="flex items-start gap-4 p-5 bg-gray-50 rounded-2xl">
              <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-0.5">Working Hours</h3>
                <p class="text-gray-600 text-sm">{hours}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-gray-50 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="rounded-2xl overflow-hidden shadow-md border border-gray-100 h-80 sm:h-96">
        <iframe
          src={mapsEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Location of BPLR–Bankya"
        ></iframe>
      </div>
      <p class="text-center text-sm text-gray-400 mt-3">
        {address} — <a href={mapsLinkUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">Open in Google Maps</a>
      </p>
    </div>
  </section>
</LandingLayout>
