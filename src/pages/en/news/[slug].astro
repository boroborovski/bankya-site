---
import BlogLayout from '../../../layouts/BlogLayout.astro'
import { readCollectionEntry } from '../../../lib/content'
import Markdoc from '@markdoc/markdoc'
import { markdocConfig } from '../../../lib/markdoc-config'
import fs from 'node:fs/promises'

const { slug } = Astro.params
const postData = await readCollectionEntry('posts', slug!, 'en')

if (!postData) return Astro.redirect('/en/news')
const post = postData.entry

const raw = await fs.readFile(postData.filePath, 'utf8')
const withoutFrontmatter = raw.replace(/^---[\s\S]*?---\s*/, '')
const ast = Markdoc.parse(withoutFrontmatter)
const transformed = Markdoc.transform(ast, markdocConfig)
const html = Markdoc.renderers.html(transformed)

const dateFormatted = post.publishDate
  ? new Date(post.publishDate).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
    })
  : null
---

<BlogLayout
  title={`${post.title} — BPLR–BANKYA`}
  description={post.summary ?? undefined}
  lang="en"
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <a href="/en/news" class="inline-flex items-center text-sm text-blue-700 hover:text-blue-900 font-medium mb-8 transition-colors">
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      All News
    </a>

    <div class="mb-6 flex flex-wrap items-center gap-3 text-sm text-gray-400">
      {dateFormatted && <time>{dateFormatted}</time>}
      {post.author && <><span>·</span><span>{post.author}</span></>}
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-6">{post.title}</h1>

    {post.summary && (
      <p class="text-xl text-gray-500 leading-relaxed mb-10 pb-10 border-b border-gray-100">{post.summary}</p>
    )}

    <div class="prose prose-lg prose-blue max-w-none
      prose-headings:font-bold prose-headings:tracking-tight
      prose-a:text-blue-700 prose-a:no-underline hover:prose-a:underline
      prose-table:w-full prose-table:text-sm prose-table:border-collapse
      prose-th:bg-blue-50 prose-th:text-blue-900 prose-th:font-semibold prose-th:px-4 prose-th:py-2 prose-th:border prose-th:border-blue-200
      prose-td:px-4 prose-td:py-2 prose-td:border prose-td:border-gray-200
      prose-img:rounded-xl prose-img:shadow-md">
      <Fragment set:html={html} />
    </div>
  </article>
</BlogLayout>
