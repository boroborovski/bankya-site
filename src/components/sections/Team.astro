---
interface TeamMember {
  name: string
  role: string
  bio?: string
  photo?: string
  linkedin?: string
  twitter?: string
}

interface Props {
  heading?: string
  subheading?: string
  members: TeamMember[]
}

const { heading = 'Meet the team', subheading, members } = Astro.props
---

<section class="bg-white py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">{heading}</h2>
      {subheading && <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">{subheading}</p>}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
      {members.map((member) => (
        <div class="text-center">
          <div class="w-24 h-24 mx-auto rounded-full overflow-hidden bg-gray-200 mb-4">
            {member.photo
              ? <img src={member.photo} alt={member.name} class="w-full h-full object-cover" />
              : <div class="w-full h-full flex items-center justify-center text-gray-400 text-2xl font-bold">
                  {member.name.charAt(0)}
                </div>
            }
          </div>
          <h3 class="text-lg font-semibold text-gray-900">{member.name}</h3>
          <p class="text-sm text-gray-500 mb-2">{member.role}</p>
          {member.bio && <p class="text-sm text-gray-600 leading-relaxed">{member.bio}</p>}
          <div class="flex justify-center gap-3 mt-3">
            {member.linkedin && (
              <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-700 text-sm">
                LinkedIn
              </a>
            )}
            {member.twitter && (
              <a href={member.twitter} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-700 text-sm">
                Twitter
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
