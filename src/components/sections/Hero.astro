---
interface Props {
  headline: string
  subheadline?: string
  ctaLabel?: string
  ctaUrl?: string
  secondaryCtaLabel?: string
  secondaryCtaUrl?: string
  image?: string
}

const {
  headline,
  subheadline,
  ctaLabel = 'Get started',
  ctaUrl = '/contact',
  secondaryCtaLabel,
  secondaryCtaUrl,
  image,
} = Astro.props
---

<section class="relative bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class={`flex flex-col gap-12 ${image ? 'lg:flex-row lg:items-center' : 'items-center text-center'}`}>
      <!-- Text -->
      <div class={image ? 'lg:w-1/2' : 'max-w-3xl'}>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight">
          {headline}
        </h1>
        {subheadline && (
          <p class="mt-6 text-lg sm:text-xl text-gray-500 leading-relaxed">
            {subheadline}
          </p>
        )}
        <div class="mt-8 flex flex-wrap gap-4 {image ? '' : 'justify-center'}">
          <a
            href={ctaUrl}
            class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors"
          >
            {ctaLabel}
          </a>
          {secondaryCtaLabel && secondaryCtaUrl && (
            <a
              href={secondaryCtaUrl}
              class="inline-flex items-center px-6 py-3 text-base font-medium text-gray-900 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
            >
              {secondaryCtaLabel}
            </a>
          )}
        </div>
      </div>

      <!-- Image -->
      {image && (
        <div class="lg:w-1/2">
          <img
            src={image}
            alt=""
            class="w-full rounded-2xl shadow-xl object-cover"
          />
        </div>
      )}
    </div>
  </div>
</section>
