---
interface Post {
  title: string
  slug: string
  date?: string
  summary?: string
  image?: string
  author?: string
}

interface Props {
  heading?: string
  subheading?: string
  posts: Post[]
  ctaLabel?: string
  ctaUrl?: string
  background?: 'white' | 'gray'
}

const { heading, subheading, posts, ctaLabel, ctaUrl, background = 'white' } = Astro.props
const bg = background === 'gray' ? 'bg-gray-50' : 'bg-white'
---

<section class={`${bg} py-16 sm:py-20`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {(heading || subheading) && (
      <div class="text-center mb-14">
        {heading && (
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900">
            {heading}
          </h2>
        )}
        {subheading && (
          <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">{subheading}</p>
        )}
      </div>
    )}

    {posts.length === 0 ? (
      <div class="text-center py-16 text-gray-400">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-lg">Все още няма публикувани новини.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden hover:shadow-md transition-shadow flex flex-col">
            <a href={`/novini/${post.slug}`} class="block overflow-hidden">
              {post.image ? (
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-48 bg-blue-50 flex items-center justify-center">
                  <svg class="w-12 h-12 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
              )}
            </a>
            <div class="p-6 flex flex-col flex-1">
              {post.date && (
                <time class="text-xs text-gray-400 mb-2 block uppercase tracking-wide">{post.date}</time>
              )}
              <h3 class="text-lg font-bold text-gray-900 mb-2 leading-snug flex-1">
                <a href={`/novini/${post.slug}`} class="hover:text-blue-700 transition-colors">
                  {post.title}
                </a>
              </h3>
              {post.summary && (
                <p class="text-sm text-gray-500 leading-relaxed line-clamp-3 mb-4">{post.summary}</p>
              )}
              <a
                href={`/novini/${post.slug}`}
                class="inline-flex items-center text-sm font-semibold text-blue-700 hover:text-blue-900 transition-colors mt-auto"
              >
                Прочети повече
                <svg class="ml-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

    {ctaLabel && ctaUrl && (
      <div class="text-center mt-12">
        <a
          href={ctaUrl}
          class="inline-flex items-center px-6 py-3 text-base font-semibold text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 transition-colors"
        >
          {ctaLabel}
        </a>
      </div>
    )}
  </div>
</section>
