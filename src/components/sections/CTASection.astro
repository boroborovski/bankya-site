---
interface Props {
  heading: string
  body?: string
  ctaLabel: string
  ctaUrl: string
  secondaryCtaLabel?: string
  secondaryCtaUrl?: string
  variant?: 'blue' | 'light'
}

const {
  heading,
  body,
  ctaLabel,
  ctaUrl,
  secondaryCtaLabel,
  secondaryCtaUrl,
  variant = 'blue',
} = Astro.props
---

{variant === 'blue' ? (
  <section class="bg-blue-700">
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-20 lg:px-6">
      <div class="max-w-screen-md">
        <h2 class="mb-4 text-3xl sm:text-4xl tracking-tight font-extrabold text-white leading-tight">
          {heading}
        </h2>
        {body && (
          <p class="mb-8 font-light text-blue-100 sm:text-xl">{body}</p>
        )}
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={ctaUrl}
            class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-blue-700 bg-white rounded-lg hover:bg-blue-50 focus:ring-4 focus:ring-blue-300 transition-colors"
          >
            {ctaLabel}
          </a>
          {secondaryCtaLabel && secondaryCtaUrl && (
            <a
              href={secondaryCtaUrl}
              class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white border-2 border-white rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-200 transition-colors"
            >
              {secondaryCtaLabel}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="bg-gray-50">
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-20 lg:px-6">
      <div class="max-w-screen-sm mx-auto text-center">
        <h2 class="mb-4 text-3xl sm:text-4xl tracking-tight font-extrabold text-gray-900 leading-tight">
          {heading}
        </h2>
        {body && (
          <p class="mb-8 font-light text-gray-500 sm:text-xl">{body}</p>
        )}
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={ctaUrl}
            class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 transition-colors"
          >
            {ctaLabel}
          </a>
          {secondaryCtaLabel && secondaryCtaUrl && (
            <a
              href={secondaryCtaUrl}
              class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-100 transition-colors"
            >
              {secondaryCtaLabel}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
)}
