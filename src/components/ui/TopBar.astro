---
interface Props {
  phone?: string
  email?: string
  hours?: string
}

const {
  phone = '02 997 7194',
  email = 'bbbankya@abv.bg',
  hours = 'Пон – Пет: 08:00 – 18:00',
} = Astro.props
---

<div class="bg-blue-700 text-white text-sm py-2 px-4">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
    <div class="flex items-center gap-6 flex-wrap">
      {phone && (
        <a
          href={`tel:${phone.replace(/\s/g, '')}`}
          class="flex items-center gap-1.5 hover:text-blue-200 transition-colors"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {phone}
        </a>
      )}
      {email && (
        <a
          href={`mailto:${email}`}
          class="hidden sm:flex items-center gap-1.5 hover:text-blue-200 transition-colors"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {email}
        </a>
      )}
    </div>
    {hours && (
      <div class="flex items-center gap-1.5 text-blue-100">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {hours}
      </div>
    )}
  </div>
</div>
