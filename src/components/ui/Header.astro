---
import { readSingleton } from '../../lib/content'
import { getNavItems, getAlternateUrl, ui } from '../../lib/i18n'
import type { Locale } from '../../lib/i18n'
import TopBar from './TopBar.astro'
import MobileMenu from '../islands/MobileMenu.svelte'

interface Props {
  lang?: Locale
}

const { lang = 'bg' } = Astro.props

const settings = await readSingleton('settings')

const phone = settings?.phone || '02 997 7194'
const email = settings?.email || 'bbbankya@abv.bg'
const hours = settings?.hours || 'Пон – Пет: 08:00 – 18:00'

const navItems = getNavItems(lang)
const strings = ui[lang]

const currentPath = Astro.url.pathname
const alternateLang: Locale = lang === 'bg' ? 'en' : 'bg'
const alternatePath = getAlternateUrl(currentPath, alternateLang)
const alternateLangLabel = lang === 'bg' ? 'EN' : 'BG'
const currentLangLabel = lang === 'bg' ? 'BG' : 'EN'

const homeUrl = lang === 'bg' ? '/' : '/en/'
const contactUrl = lang === 'bg' ? '/kontakti' : '/en/contact'
---

<TopBar phone={phone} email={email} hours={hours} />

<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <!-- Logo -->
      <a href={homeUrl} class="flex items-center gap-2.5 shrink-0">
        {settings?.logo ? (
          <img src={settings.logo} alt={settings.siteName || 'БПЛР–БАНКЯ'} class="h-14 w-auto" />
        ) : (
          <span class="text-blue-700 font-extrabold text-lg tracking-tight leading-tight">
            БПЛР<span class="text-gray-900">–БАНКЯ</span>
          </span>
        )}
      </a>

      <!-- Desktop nav -->
      <ul class="hidden lg:flex items-center gap-1">
        {navItems.map((item) =>
          item.subItems ? (
            <li class="group relative">
              <a
                href={item.url}
                class={`inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors ${
                  currentPath.startsWith(item.url)
                    ? 'text-blue-700 bg-blue-50'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
                }`}
              >
                {item.label}
                <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <ul class="absolute top-full left-0 mt-1 w-52 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                {item.subItems.map((sub) => (
                  <li>
                    <a
                      href={sub.url}
                      class="block px-4 py-2.5 text-sm text-gray-600 hover:text-blue-700 hover:bg-blue-50 transition-colors"
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.url}
                class={`inline-flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors ${
                  currentPath === item.url || (item.url !== '/' && item.url !== '/en/' && currentPath.startsWith(item.url))
                    ? 'text-blue-700 bg-blue-50'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
                }`}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>

      <!-- CTA + Language switcher + Mobile toggle -->
      <div class="flex items-center gap-2">
        <!-- Language switcher -->
        <a
          href={alternatePath}
          class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold rounded-md border border-gray-200 text-gray-600 hover:border-blue-300 hover:text-blue-700 transition-colors"
          title={alternateLang === 'en' ? 'Switch to English' : 'Превключи на български'}
        >
          <span class="text-gray-400">{currentLangLabel}</span>
          <span class="text-gray-300">/</span>
          <span>{alternateLangLabel}</span>
        </a>

        <a
          href={contactUrl}
          class="hidden lg:inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-blue-700 rounded-lg hover:bg-blue-800 transition-colors"
        >
          {strings.ctaButton}
        </a>
        <MobileMenu
          navItems={navItems}
          ctaUrl={contactUrl}
          ctaLabel={strings.ctaButton}
          alternatePath={alternatePath}
          alternateLangLabel={alternateLangLabel}
          openMenuLabel={strings.openMenu}
          closeMenuLabel={strings.closeMenu}
          closeLabel={strings.close}
          client:load
        />
      </div>
    </div>
  </nav>
</header>
