---
import { createReader } from '@keystatic/core/reader'
import keystaticConfig from '../../../keystatic.config'

const reader = createReader(process.cwd(), keystaticConfig)
const settings = await reader.singletons.settings.read()

const year = new Date().getFullYear()
const siteName = settings?.siteName || 'БПЛР–БАНКЯ'
const footerDesc = settings?.footerDescription || 'Специализирана болница за рехабилитация в Банкя, предлагаща комплексно лечение с природни минерални води и съвременни методи.'
const phone = settings?.phone || '02 997 7194'
const email = settings?.email || 'bbbankya@abv.bg'
const address = settings?.address || 'гр. Банкя, ул. „Цар Симеон" № 2, 1320'
const hours = settings?.hours || 'Пон – Пет: 08:00 – 18:00'
const facebookUrl = settings?.facebookUrl || null
---

<footer class="bg-gray-900 text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-8">

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 mb-12">

      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex flex-col mb-4">
          {settings?.logo ? (
            <img src={settings.logo} alt={siteName} class="h-10 w-auto brightness-0 invert" />
          ) : (
            <>
              <span class="text-white font-extrabold text-xl tracking-tight">{siteName}</span>
              <span class="text-blue-400 text-xs font-medium tracking-wide mt-0.5">Болница за продължително лечение и рехабилитация</span>
            </>
          )}
        </a>
        <p class="text-sm leading-relaxed mt-3">{footerDesc}</p>
        {facebookUrl && (
          <div class="flex gap-3 mt-5">
            <a
              href={facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-white transition-colors"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        )}
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-white text-sm font-semibold mb-5 uppercase tracking-wider">Навигация</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Начало</a></li>
          <li><a href="/za-nas" class="hover:text-white transition-colors">За нас</a></li>
          <li><a href="/deynosti" class="hover:text-white transition-colors">Дейности</a></li>
          <li><a href="/za-pacienta" class="hover:text-white transition-colors">За пациента</a></li>
          <li><a href="/galeriya" class="hover:text-white transition-colors">Галерия</a></li>
          <li><a href="/novini" class="hover:text-white transition-colors">Новини</a></li>
        </ul>
      </div>

      <!-- For Patients -->
      <div>
        <h3 class="text-white text-sm font-semibold mb-5 uppercase tracking-wider">За пациента</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/za-pacienta#obshta" class="hover:text-white transition-colors">Обща информация</a></li>
          <li><a href="/za-pacienta#klinichni" class="hover:text-white transition-colors">Клинични пътеки</a></li>
          <li><a href="/za-pacienta#noi" class="hover:text-white transition-colors">НОИ</a></li>
          <li><a href="/za-pacienta#platen" class="hover:text-white transition-colors">Платен прием</a></li>
          <li><a href="/za-pacienta#voenen" class="hover:text-white transition-colors">Военен контингент</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white text-sm font-semibold mb-5 uppercase tracking-wider">Контакти</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{address}</span>
          </li>
          <li>
            <a href={`tel:${phone.replace(/\s/g, '')}`} class="flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`} class="flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {email}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {hours}
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
      <p>&copy; {year} {siteName}. Всички права запазени.</p>
      <a href="/kontakti" class="text-blue-400 hover:text-blue-300 transition-colors font-medium">
        Запишете час →
      </a>
    </div>
  </div>
</footer>
