---
const year = new Date().getFullYear()
---

<footer class="bg-gray-900 text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <a href="/" class="text-white text-xl font-bold">YourBrand</a>
        <p class="mt-3 text-sm leading-relaxed">
          A short description of your company or website goes here.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Pages</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/services" class="hover:text-white transition-colors">Services</a></li>
          <li><a href="/team" class="hover:text-white transition-colors">Team</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Follow us</h3>
        <div class="flex gap-4">
          <a href="#" class="hover:text-white transition-colors text-sm">Twitter</a>
          <a href="#" class="hover:text-white transition-colors text-sm">LinkedIn</a>
          <a href="#" class="hover:text-white transition-colors text-sm">GitHub</a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 text-sm text-center">
      &copy; {year} YourBrand. All rights reserved.
    </div>
  </div>
</footer>
